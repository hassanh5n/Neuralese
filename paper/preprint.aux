\@writefile{lof}{\contentsline {figure}{\numberline {A2}{\ignorespaces Per-fork shares behind the pooled bars of \cref  {fig:patch}, for layer 0 and layers 0--3. Each dot is one fork with a blend--control gap of at least 0.1 (78 number vs number forks, 108 word vs word); filled = remove, open = insert. Black bar: median per fork. Diamond: pooled share, as plotted in \cref  {fig:patch}. For number vs number, layer 0 is uneven across forks: half of them have a remove share below 0.12 and a quarter are above 0.68, so the pooled 0.38 sits well above the median fork (0.12; insert: 0.16 vs 0.02). For layers 0--3 the median fork is close to the pooled share. Dots outside the axis range are drawn at its edge as triangles.\relax }}{18}{figure.caption.39}\protected@file@percent }
\newlabel{fig:perfork}{{A2}{18}{Per-fork shares behind the pooled bars of \cref {fig:patch}, for layer 0 and layers 0--3. Each dot is one fork with a blend--control gap of at least 0.1 (78 number vs number forks, 108 word vs word); filled = remove, open = insert. Black bar: median per fork. Diamond: pooled share, as plotted in \cref {fig:patch}. For number vs number, layer 0 is uneven across forks: half of them have a remove share below 0.12 and a quarter are above 0.68, so the pooled 0.38 sits well above the median fork (0.12; insert: 0.16 vs 0.02). For layers 0--3 the median fork is close to the pooled share. Dots outside the axis range are drawn at its edge as triangles.\relax }{figure.caption.39}{}}
\newlabel{fig:perfork@cref}{{[figure][2][2147483647]A2}{[1][16][]18}}
