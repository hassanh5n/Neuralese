\@writefile{lof}{\contentsline {figure}{\numberline {A1}{\ignorespaces Readback at each position of the forced text, without the binning of \cref  {fig:readback}b--c. Top: mean readback (control minus blend) with 95\% bootstrap CIs over problems, for the runner-up's text (left) and the model's own text (right). Bottom: number of forks with a defined score at that position (positions where the chosen token and the runner-up barely differ are skipped). With the runner-up's text, the mean stays above 0 at every position for number vs number and word vs word; with the model's own text it stays around 0. Single positions hold few forks, so their CIs are wide; this is why \cref  {fig:readback} pools positions into log-spaced bins.\relax }}{17}{figure.caption.38}\protected@file@percent }
\newlabel{fig:readback-unbinned}{{A1}{17}{Readback at each position of the forced text, without the binning of \cref {fig:readback}b--c. Top: mean readback (control minus blend) with 95\% bootstrap CIs over problems, for the runner-up's text (left) and the model's own text (right). Bottom: number of forks with a defined score at that position (positions where the chosen token and the runner-up barely differ are skipped). With the runner-up's text, the mean stays above 0 at every position for number vs number and word vs word; with the model's own text it stays around 0. Single positions hold few forks, so their CIs are wide; this is why \cref {fig:readback} pools positions into log-spaced bins.\relax }{figure.caption.38}{}}
\newlabel{fig:readback-unbinned@cref}{{[figure][1][2147483647]A1}{[1][16][]17}}
