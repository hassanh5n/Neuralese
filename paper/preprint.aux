\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces The four questions we test. (1) Does a blend of two candidates survive the layers, or snap to one of them (\cref  {fig:snap})? (2) Is the runner-up stored in the K,V cache, and can later steps read it back (\cref  {fig:readback,fig:patch})? (3) What blends does the noise actually feed in real runs (\cref  {fig:fed})? (4) Does the residual move the model's next-token predictions more than a random residual of the same size (\cref  {fig:ablation}, \cref  {tab:accuracy})? Drawings are schematic.\relax }}{3}{figure.caption.2}\protected@file@percent }
\newlabel{fig:questions}{{2}{3}{The four questions we test. (1) Does a blend of two candidates survive the layers, or snap to one of them (\cref {fig:snap})? (2) Is the runner-up stored in the K,V cache, and can later steps read it back (\cref {fig:readback,fig:patch})? (3) What blends does the noise actually feed in real runs (\cref {fig:fed})? (4) Does the residual move the model's next-token predictions more than a random residual of the same size (\cref {fig:ablation}, \cref {tab:accuracy})? Drawings are schematic.\relax }{figure.caption.2}{}}
